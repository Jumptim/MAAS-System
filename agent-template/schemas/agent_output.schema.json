{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Output",
  "type": "object",
  "required": ["agent_id", "parent_workflow_step_id", "status", "result", "warnings", "errors", "memory_refs", "log_refs"],
  "properties": {
    "agent_id": { "type": "string" },
    "parent_workflow_step_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["success", "partial_success", "failed"]
    },
    "result": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource_id": { "type": "string" },
          "document_id": { "type": "string" },
          "section": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "memory_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "log_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

