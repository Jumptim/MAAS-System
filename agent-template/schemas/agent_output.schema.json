{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Output",
  "type": "object",
  "required": [
    "agent_id",
    "parent_workflow_step_id",
    "agent_type",
    "status",
    "decision",
    "decision_source",
    "target_step_id",
    "result",
    "warnings",
    "errors",
    "memory_refs",
    "log_refs"
  ],
  "properties": {
    "agent_id": { "type": "string" },
    "parent_workflow_step_id": { "type": "string" },
    "agent_type": {
      "type": "string",
      "enum": ["normal", "evaluator"]
    },
    "status": {
      "type": "string",
      "enum": ["valid", "repaired", "invalid", "failed"]
    },
    "decision": {
      "type": "string",
      "enum": ["continue", "iterate", "fail"]
    },
    "decision_source": {
      "type": "string",
      "enum": ["runtime_contract_gate", "evaluator_judgement"]
    },
    "target_step_id": {
      "type": ["string", "null"]
    },
    "result": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource_id", "document_id", "section", "summary"],
        "properties": {
          "resource_id": { "type": "string" },
          "document_id": { "type": "string" },
          "section": { "type": "string" },
          "summary": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "memory_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "log_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
