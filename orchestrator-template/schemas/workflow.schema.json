{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Configuration Schema",
  "type": "object",
  "required": ["workflow", "steps", "terminal_steps"],
  "properties": {
    "workflow": {
      "type": "object",
      "required": ["id", "name", "version", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "orchestrator_policy": {
      "type": "object",
      "properties": {
        "on_agent_output_invalid": {
          "type": "string",
          "enum": ["fail_workflow", "stop_for_human_review", "allow_step_iteration"]
        },
        "on_agent_output_failed": {
          "type": "string",
          "enum": ["fail_workflow", "stop_for_human_review"]
        },
        "on_invalid_decision": {
          "type": "string",
          "enum": ["fail_workflow", "stop_for_human_review"]
        },
        "on_disallowed_transition": {
          "type": "string",
          "enum": ["fail_workflow", "stop_for_human_review"]
        },
        "on_mapping_failed": {
          "type": "string",
          "enum": ["fail_workflow", "stop_for_human_review"]
        },
        "on_iteration_limit_reached": {
          "type": "string",
          "enum": ["fail_workflow", "stop_for_human_review"]
        },
        "max_total_iterations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent", "input", "allowed_decisions"],
        "properties": {
          "id": { "type": "string" },
          "agent": {
            "type": "object",
            "required": ["id", "role", "description"],
            "properties": {
              "id": { "type": "string" },
              "role": {
                "type": "string",
                "enum": ["normal_agent", "evaluator_agent"]
              },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          },
          "input": {
            "type": "object",
            "required": ["source", "mapping"],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "workflow_initial_input",
                  "previous_step_output",
                  "selected_step_output",
                  "multiple_step_outputs",
                  "custom"
                ]
              },
              "mapping": {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": ["orchestrator_default", "custom"]
                  },
                  "mapping_id": {
                    "type": ["string", "null"]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "allowed_decisions": {
            "type": "object",
            "required": ["continue", "iterate", "fail"],
            "properties": {
              "continue": { "$ref": "#/$defs/transition" },
              "iterate": { "$ref": "#/$defs/iteration_transition" },
              "fail": { "$ref": "#/$defs/transition" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "terminal_steps": {
      "type": "object",
      "required": ["workflow_completed", "workflow_failed"],
      "properties": {
        "workflow_completed": { "$ref": "#/$defs/terminal_step" },
        "workflow_failed": { "$ref": "#/$defs/terminal_step" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "required": ["next_step"],
      "properties": {
        "next_step": { "type": "string" },
        "mapping": { "$ref": "#/$defs/mapping" }
      },
      "additionalProperties": false
    },
    "iteration_transition": {
      "type": "object",
      "required": ["max_iterations"],
      "properties": {
        "next_step": { "type": "string" },
        "allowed_next_steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "mapping": { "$ref": "#/$defs/mapping" }
      },
      "anyOf": [
        { "required": ["next_step"] },
        { "required": ["allowed_next_steps"] }
      ],
      "not": {
        "required": ["next_step", "allowed_next_steps"]
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["orchestrator_default", "custom"]
        },
        "mapping_id": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "terminal_step": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "failed"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
